# OpenAI API 키. 서버(Route Handler)에서만 사용하며, 절대 NEXT_PUBLIC_ 접두어를 붙이지 않는다.
OPENAI_API_KEY=

# 작품 분석에 쓸 모델. 계정/프로젝트마다 접근 가능한 모델이 다르므로, 403(no access)이 나오면
# https://api.openai.com/v1/models 응답에서 실제로 쓸 수 있는 모델명으로 바꿔야 한다.
OPENAI_ARTWORK_MODEL=gpt-5.4-mini

# false로 두거나 지우면 AI 분석 없이 규칙 기반 fallback만 사용한다.
# 키가 없어도 이 값과 무관하게 항상 fallback으로 동작한다(그림 제출은 절대 막히지 않는다).
ENABLE_AI_ANALYSIS=true

# true일 때만 /debug/ai 화면과 작품 카드의 "개발자 정보" 패널이 보인다. 운영 배포에서는 false.
NEXT_PUBLIC_ENABLE_AI_DEBUG=false

# 공동 캔버스(weekly_canvases·drawing_contributions)를 저장하는 Supabase 프로젝트.
# anon 키만 쓴다(RLS로 보호됨) — service_role 키는 절대 여기 두지 않는다.
# 스키마는 README의 "Supabase 스키마" 절 SQL을 Supabase SQL Editor에서 한 번 실행하면 된다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
